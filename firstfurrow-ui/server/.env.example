# ── Required ────────────────────────────────────────────────────────────────
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/firstfurrow
# MongoDB Atlas (put the database name before the "?"):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/firstfurrow?retryWrites=true&w=majority

# Signs login tokens. REQUIRED in production, at least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (Keep it secret. Changing it logs everyone out.)
JWT_SECRET=

# ── "Forgot password" emails ────────────────────────────────────────────────
# The server sends reset links through a Gmail account using a Google "App password"
# (NOT your normal Gmail password). How to get one: see DEPLOY.md, step 4.
MAIL_USER=
MAIL_APP_PASSWORD=
# Your website's address — reset links in emails point here (no trailing slash).
# Local development can leave this empty (it defaults to http://localhost:5173).
APP_URL=
# Both are REQUIRED for "Forgot password" to work. If MAIL_USER is empty, the forgot-password
# screen shows an error (emails are never printed in the terminal).

# On Render's FREE plan, Gmail/SMTP is blocked. Use Brevo (free, sends over HTTPS) instead:
#   1) brevo.com → sign up → Senders → add and verify MAIL_USER as a sender
#   2) SMTP & API → API Keys → create a key (starts with xkeysib-)
# BREVO_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# MAIL_FROM="FirstFurrow <you@gmail.com>"   # default: FirstFurrow <MAIL_USER>
# RESET_TOKEN_MINUTES=30                     # how long a reset link works
# Not using Gmail? Point at any SMTP server instead:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
PORT=5000
NODE_ENV=development        # set to "production" when deployed

# Only if the React app is hosted on a DIFFERENT domain than this API (comma-separated).
# Not needed when this server serves the app itself.
# CLIENT_ORIGIN=https://your-app.vercel.app

# Set to "false" if the frontend is hosted elsewhere and this server should only be an API.
# SERVE_CLIENT=false

# Login lasts this long (default 7d)
# JWT_EXPIRES_IN=7d

# Behind a hosting platform's proxy (Render, Railway, Heroku…) leave at 1. Running with no proxy: 0.
# TRUST_PROXY=1
